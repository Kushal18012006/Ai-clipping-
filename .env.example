# Optional. Without a key the app still works: it uses YouTube captions (when
# available) plus audio-energy analysis to find highlights.
# Any OpenAI-compatible API works (OpenAI, Groq, OpenRouter, a local gateway...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1

# Server
PORT=5180
